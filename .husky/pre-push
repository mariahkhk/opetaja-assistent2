# Consume Git's pre-push ref list so Bun/Playwright test runners don't inherit
# pipe input and treat the hook as an interactive/streaming session.
cat > /dev/null

# Run linting
echo "Linting..."
if ! bun run lint > /dev/null 2>&1; then
  echo "❌ Linting failed"
  bun run lint
  exit 1
fi

# Security scans (OWASP A06 — Vulnerable Components)
# Block on high/critical only; moderate/low are informational.
echo "Security scan..."
if ! bun audit --audit-level=high > /dev/null 2>&1; then
  echo "❌ bun audit found high/critical vulnerabilities"
  bun audit --audit-level=high
  exit 1
fi

# Run tests
echo "Testing..."
if ! bun test > /dev/null 2>&1; then
  echo "❌ Tests failed"
  bun test
  exit 1
fi

# Run full E2E suite (~5 min with workers=4). Catches every documented
# regression class — Tahvel page features, Kriit sync flows, popup,
# multi-tab crypto rotation. Worth the wait per project policy.
echo "E2E (full)..."
if ! bun run test:e2e > /dev/null 2>&1; then
  echo "❌ E2E failed"
  bun run test:e2e
  exit 1
fi

exit 0
