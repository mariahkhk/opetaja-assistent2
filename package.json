{
  "name": "opetaja-assistent2",
  "version": "1.8.0",
  "description": "Extension for enhancing Tahvel educational platform functionality",
  "type": "module",
  "private": true,
  "main": "src/content.js",
  "author": "henno",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "eslint": "^10.6.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1"
  },
  "scripts": {
    "start": "bun install && bun run lint:fix && bun run dev",
    "dev": "bun run build:dev && bun run watch",
    "build": "bun run lint && bun run build:prod",
    "build:dev": "bun src/assets/scripts/build.js",
    "build:prod": "bun src/assets/scripts/build.js --prod",
    "watch": "bun src/assets/scripts/watch.js",
    "test": "bun test",
    "test:e2e": "bun --bun x playwright test",
    "test:e2e:smoke": "bun --bun x playwright test tests/e2e/popup.e2e.js tests/e2e/sentry.e2e.js tests/e2e/crypto-rotation.e2e.js",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "eslint src/ --fix",
    "prepare": "bun --bun x husky",
    "postinstall": "bun -e \"if(!process.env.CI)Bun.spawnSync(['bun','--bun','x','playwright','install','chromium'],{stdio:['inherit','inherit','inherit']})\""
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "overrides": {
    "undici": "^7.28.0"
  }
}

