{
  "name": "opetaja-assistent2",
  "version": "1.8.0",
  "description": "Extension for enhancing Tahvel educational platform functionality",
  "type": "module",
  "private": true,
  "main": "src/content.js",
  "author": "henno",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "retire": "^5.4.2"
  },
  "scripts": {
    "start": "bun install && find src -name '*.js' -print0 | xargs -0 ./node_modules/.bin/eslint --fix && bun run dev",
    "dev": "bun run build:dev && bun run watch",
    "build": "bun run lint && bun run build:prod",
    "build:dev": "bun src/assets/scripts/build.js",
    "build:prod": "bun src/assets/scripts/build.js --prod",
    "watch": "bun src/assets/scripts/watch.js",
    "test": "bun test",
    "test:e2e": "bun --bun x playwright test",
    "test:e2e:smoke": "bun --bun x playwright test tests/e2e/popup.e2e.js tests/e2e/sentry.e2e.js tests/e2e/crypto-rotation.e2e.js",
    "lint": "./node_modules/.bin/eslint src/**/*.js --max-warnings 0",
    "lint:fix": "./node_modules/.bin/eslint src/**/*.js --fix",
    "format": "./node_modules/.bin/eslint src/**/*.js --fix",
    "prepare": "husky",
    "postinstall": "[ -n \"$CI\" ] || bun --bun x playwright install chromium"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "sharp": "^0.34.1"
  }
}
